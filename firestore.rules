rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function dealer() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dealerApproved == true; }
    match /products/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /wholesalePrices/{id} {
      allow read: if admin() || dealer();
      allow write: if admin();
    }
    match /users/{uid} {
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['name','email','phone','dealerRequested','dealerApproved','createdAt']) && request.resource.data.dealerApproved == false && request.resource.data.dealerRequested is bool;
      allow read: if owner(uid) || admin();
      allow update: if admin() || (owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','dealerRequested']));
      allow delete: if admin();
    }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_review'
        && request.resource.data.keys().hasOnly(['userId','items','status','createdAt','requestedMode','note','buyer','paymentMethod'])
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.buyer.keys().hasOnly(['name','phone','governorate','address'])
        && request.resource.data.buyer.name is string && request.resource.data.buyer.name.size() > 0 && request.resource.data.buyer.name.size() <= 100
        && request.resource.data.buyer.phone is string && request.resource.data.buyer.phone.size() >= 10 && request.resource.data.buyer.phone.size() <= 16
        && request.resource.data.buyer.governorate is string && request.resource.data.buyer.governorate.size() > 0 && request.resource.data.buyer.governorate.size() <= 60
        && request.resource.data.buyer.address is string && request.resource.data.buyer.address.size() >= 10 && request.resource.data.buyer.address.size() <= 300
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 60
        && request.resource.data.requestedMode in ['retail','wholesale']
        && (request.resource.data.requestedMode == 'retail' || dealer())
        && request.resource.data.items[0].keys().hasOnly(['productId','quantity'])
        && request.resource.data.items[0].quantity is int
        && request.resource.data.items[0].quantity > 0 && request.resource.data.items[0].quantity <= 100;
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if admin();
    }
    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt']) && request.resource.data.email is string && request.resource.data.email.size() <= 254;
      allow read, update, delete: if admin();
    }
  }
}
